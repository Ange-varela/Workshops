
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar curso</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">

        <h1 class="mb-4">Editar curso</h1>

        <form action="/cursos/actualizar/<%= curso.id %>" method="POST">

            <div class="mb-3">
                <label class="form-label">Nombre del curso</label>
                <input type="text" name="nombre" class="form-control"
                    value="<%= curso.nombre %>" maxlength="100" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Código del curso</label>
                <input type="text" name="codigo_curso" class="form-control"
                    value="<%= curso.codigo_curso %>" maxlength="20" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Carrera ID</label>
                <input type="number" name="carrera_id" class="form-control"
                    value="<%= curso.carrera_id %>" min="1" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Créditos</label>
                <input type="number" name="creditos" class="form-control"
                    value="<%= curso.creditos %>" min="1" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea name="descripcion" class="form-control" rows="3"><%= curso.descripcion || '' %></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Actualizar curso
            </button>

            <a href="/cursos" class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>

</body>
</html>

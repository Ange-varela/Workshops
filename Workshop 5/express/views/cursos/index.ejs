
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de cursos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">

        <h1 class="mb-4">Lista de cursos</h1>

        <a href="/cursos/crear" class="btn btn-primary mb-3">
            Agregar curso
        </a>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Carrera ID</th>
                    <th>Créditos</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                <% cursos.forEach(curso => { %>
                    <tr>
                        <td><%= curso.id %></td>
                        <td><%= curso.nombre %></td>
                        <td><%= curso.codigo_curso %></td>
                        <td><%= curso.carrera_id %></td>
                        <td><%= curso.creditos %></td>
                        <td><%= curso.descripcion %></td>
                        <td>
                            <a href="/cursos/editar/<%= curso.id %>" class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <form action="/cursos/eliminar/<%= curso.id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Desea eliminar este curso?')">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    </div>

</body>
</html>

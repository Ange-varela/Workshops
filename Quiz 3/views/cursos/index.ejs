<%- include('../partials/header', { titulo: 'Cursos' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Cursos</h1>
    <a href="<%= base %>/cursos/crear" class="btn btn-primary">Agregar curso</a>
</div>

<% if (mensaje) { %>
    <div class="alert alert-success"><%= mensaje %></div>
<% } %>
<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (cursos.length === 0) { %>
    <div class="alert alert-info">No hay cursos registrados.</div>
<% } else { %>
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre del curso</th>
                <th class="text-center">Créditos</th>
                <th>Carrera</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% cursos.forEach(curso => { %>
                <tr>
                    <td><%= curso.codigo_curso %></td>
                    <td><%= curso.nombre %></td>
                    <td class="text-center"><%= curso.creditos %></td>
                    <td><%= curso.carrera %></td>
                    <td class="text-center text-nowrap">
                        <a href="<%= base %>/cursos/editar/<%= curso.id %>" class="btn btn-warning btn-sm">Editar</a>

                        <form action="<%= base %>/cursos/eliminar/<%= curso.id %>" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Desea eliminar este curso?')">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

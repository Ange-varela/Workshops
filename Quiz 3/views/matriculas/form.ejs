<%- include('../partials/header', { titulo: 'Matrícula de estudiantes' }) %>

<h1 class="mb-1">Matrícula de estudiantes</h1>
<p class="text-muted mb-4">Complete sus datos, seleccione un curso de la lista y presione <strong>Matricular</strong>.</p>

<%- include('../partials/errores', { errores }) %>

<form action="<%= base %>/matricular" method="POST">

    <div class="card card-body shadow-sm mb-4">
        <h5 class="card-title">Datos del estudiante</h5>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="cedula" class="form-label">Cédula</label>
                <input type="text" id="cedula" name="cedula" class="form-control"
                    value="<%= datos.cedula || '' %>" maxlength="20" placeholder="Ej: 2-0845-0123" required>
            </div>

            <div class="col-md-4 mb-3">
                <label for="nombre_estudiante" class="form-label">Nombre completo</label>
                <input type="text" id="nombre_estudiante" name="nombre_estudiante" class="form-control"
                    value="<%= datos.nombre_estudiante || '' %>" maxlength="100" required>
            </div>

            <div class="col-md-4 mb-3">
                <label for="correo" class="form-label">Correo</label>
                <input type="email" id="correo" name="correo" class="form-control"
                    value="<%= datos.correo || '' %>" maxlength="100" required>
            </div>
        </div>
    </div>

    <div class="card card-body shadow-sm mb-4">
        <h5 class="card-title">Seleccione un curso</h5>

        <% if (cursos.length === 0) { %>
            <div class="alert alert-info mb-0">No hay cursos disponibles para matricular.</div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Código</th>
                            <th>Curso</th>
                            <th class="text-center">Créditos</th>
                            <th>Carrera</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cursos.forEach(curso => { %>
                            <tr class="fila-curso">
                                <td>
                                    <input class="form-check-input" type="radio" name="curso_id"
                                        id="curso_<%= curso.id %>" value="<%= curso.id %>"
                                        <%= Number(datos.curso_id) === curso.id ? 'checked' : '' %> required>
                                </td>
                                <td><label for="curso_<%= curso.id %>"><%= curso.codigo_curso %></label></td>
                                <td><label for="curso_<%= curso.id %>"><%= curso.nombre %></label></td>
                                <td class="text-center"><%= curso.creditos %></td>
                                <td><%= curso.carrera %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <button type="submit" class="btn btn-success btn-lg" <%= cursos.length === 0 ? 'disabled' : '' %>>
        Matricular
    </button>

</form>

<%- include('../partials/footer') %>

<%- include('../partials/header', { titulo: 'Matrículas' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Matrículas registradas</h1>
    <a href="<%= base %>/" class="btn btn-success">Nueva matrícula</a>
</div>

<% if (matriculas.length === 0) { %>
    <div class="alert alert-info">Todavía no hay matrículas registradas.</div>
<% } else { %>
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Cédula</th>
                <th>Estudiante</th>
                <th>Curso</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% matriculas.forEach(m => { %>
                <tr>
                    <td><%= m.id %></td>
                    <td><%= m.cedula %></td>
                    <td><%= m.nombre_estudiante %></td>
                    <td><%= m.codigo_curso %> - <%= m.curso %></td>
                    <td><%= new Date(m.fecha_matricula).toLocaleString('es-CR', { timeZone: 'America/Costa_Rica' }) %></td>
                    <td class="text-center">
                        <a href="<%= base %>/matriculas/<%= m.id %>" class="btn btn-outline-primary btn-sm">Ver</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>
